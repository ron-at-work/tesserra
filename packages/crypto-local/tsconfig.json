{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@agent-proof/protocol": ["../protocol/dist/src/index.d.ts"],
      "@agent-proof/core": ["../core/dist/src/index.d.ts"]
    },
    "noEmit": false,
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "extends": "../../tsconfig.json"
}
